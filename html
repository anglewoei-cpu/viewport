<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>魅惑日語冒險：可愛日文單字發音卡與生成器 🌸✨</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&family=Zen+Maru+Gothic:wght@500;700;900&display=swap" rel="stylesheet">
    <!-- Canvas Confetti -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        pastel: {
                            pink: '#FFD1DC',
                            purple: '#E6E6FA',
                            blue: '#BECDFF',
                            green: '#C1E1C1',
                            yellow: '#FCF7DE',
                            peach: '#FCE1D4',
                            darkPink: '#FF6B8B',
                            darkPurple: '#7B61FF',
                            darkBlue: '#4A69FF',
                        }
                    },
                    fontFamily: {
                        jp: ['"Zen Maru Gothic"', '"Inter"', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <style>
        body {
            font-family: 'Zen Maru Gothic', 'Inter', sans-serif;
            background: linear-gradient(135deg, #FFF5F7 0%, #F3F0FF 50%, #F0F4FF 100%);
            background-attachment: fixed;
            user-select: none;
        }

        /* 3D Card Flip Effect */
        .perspective-1000 {
            perspective: 1000px;
        }
        .transform-style-3d {
            transform-style: preserve-3d;
        }
        .backface-hidden {
            backface-visibility: hidden;
        }
        .rotate-y-180 {
            transform: rotateY(180deg);
        }

        /* Floating Animation */
        @keyframes float {
            0%, 100% { transform: translateY(0px) rotate(0deg); }
            50% { transform: translateY(-8px) rotate(1deg); }
        }
        .animate-float {
            animation: float 3.5s ease-in-out infinite;
        }

        /* Pulse Glow Effect */
        @keyframes pulseGlow {
            0%, 100% { box-shadow: 0 0 15px rgba(255, 107, 139, 0.4); }
            50% { box-shadow: 0 0 25px rgba(255, 107, 139, 0.8); }
        }
        .pulse-glow {
            animation: pulseGlow 2s infinite;
        }

        /* Button Press Effect */
        .btn-bounce {
            transition: transform 0.15s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.15s ease;
        }
        .btn-bounce:active {
            transform: scale(0.92);
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #FFF0F5;
            border-radius: 10px;
        }
        ::-webkit-scrollbar-thumb {
            background: #FFB6C1;
            border-radius: 10px;
        }

        /* Print Layout Rules */
        @media print {
            .no-print { display: none !important; }
            body { background: white !important; }
            .card-grid-print {
                display: grid !important;
                grid-template-columns: repeat(3, 1fr) !important;
                gap: 12px !important;
            }
        }
    </style>
</head>
<body class="text-gray-800 min-h-screen flex flex-col justify-between relative overflow-x-hidden">

    <!-- Header Navbar -->
    <header class="bg-white/90 backdrop-blur-md sticky top-0 z-40 border-b border-pink-100 shadow-sm no-print">
        <div class="max-w-6xl mx-auto px-4 py-3 flex flex-wrap items-center justify-between gap-3">
            <div class="flex items-center gap-3 cursor-pointer" onclick="switchTab('map')">
                <div class="w-11 h-11 bg-pink-100 rounded-2xl flex items-center justify-center text-2xl shadow-inner animate-bounce">
                    🐱
                </div>
                <div>
                    <h1 class="font-extrabold text-xl bg-gradient-to-r from-pink-500 via-purple-500 to-indigo-500 bg-clip-text text-transparent">
                        魅惑日語大冒險 🌸
                    </h1>
                    <p class="text-xs text-gray-500 font-bold">完整假名 x 中文對照 x 地圖通關學習</p>
                </div>
            </div>

            <!-- Progress Summary Stars -->
            <div class="flex items-center gap-2 bg-pink-50/80 px-3 py-1.5 rounded-2xl border border-pink-100 text-xs font-bold text-gray-600">
                <span>⭐ 總星數: <span id="totalStarsCount" class="text-amber-500 font-extrabold text-sm">0</span> / 24</span>
                <span class="text-pink-300">|</span>
                <span>🏆 勳章: <span id="totalBadgesCount" class="text-purple-600 font-extrabold text-sm">0</span> / 8</span>
            </div>

            <!-- Main Navigation -->
            <nav class="flex items-center gap-1 bg-pink-50 p-1.5 rounded-2xl border border-pink-100 overflow-x-auto max-w-full">
                <button id="nav-map" onclick="switchTab('map')" class="px-3.5 py-1.5 rounded-xl font-bold text-xs sm:text-sm transition-all bg-white text-pink-600 shadow-sm btn-bounce flex items-center gap-1.5">
                    <i class="fa-solid fa-map"></i> 地圖冒險
                </button>
                <button id="nav-cards" onclick="switchTab('cards')" class="px-3.5 py-1.5 rounded-xl font-bold text-xs sm:text-sm text-gray-600 hover:text-pink-600 transition-all btn-bounce flex items-center gap-1.5">
                    <i class="fa-solid fa-layer-group"></i> 單字庫
                </button>
                <button id="nav-quiz" onclick="switchTab('quiz')" class="px-3.5 py-1.5 rounded-xl font-bold text-xs sm:text-sm text-gray-600 hover:text-pink-600 transition-all btn-bounce flex items-center gap-1.5">
                    <i class="fa-solid fa-circle-question"></i> 測驗
                </button>
                <button id="nav-match" onclick="switchTab('match')" class="px-3.5 py-1.5 rounded-xl font-bold text-xs sm:text-sm text-gray-600 hover:text-pink-600 transition-all btn-bounce flex items-center gap-1.5">
                    <i class="fa-solid fa-puzzle-piece"></i> 對對碰
                </button>
                <button id="nav-generator" onclick="switchTab('generator')" class="px-3.5 py-1.5 rounded-xl font-bold text-xs sm:text-sm text-gray-600 hover:text-pink-600 transition-all btn-bounce flex items-center gap-1.5">
                    <i class="fa-solid fa-wand-magic-sparkles"></i> 稱號生成器
                </button>
            </nav>
        </div>
    </header>

    <!-- Main Content Container -->
    <main class="max-w-6xl mx-auto px-4 py-6 flex-grow w-full z-10">

        <!-- ==================== TAB 1: 冒險地圖通關 (QUEST MAP) ==================== -->
        <section id="tab-map" class="space-y-6">
            
            <div class="bg-gradient-to-r from-pink-400 via-purple-400 to-indigo-400 rounded-3xl p-6 text-white shadow-lg relative overflow-hidden">
                <div class="relative z-10 flex flex-col md:flex-row justify-between items-center gap-4">
                    <div>
                        <span class="bg-white/20 px-3 py-1 rounded-full text-xs font-bold border border-white/30 backdrop-blur-sm">🗺️ 地圖通關模式</span>
                        <h2 class="text-2xl sm:text-3xl font-black mt-2">魅惑詞彙探索之旅</h2>
                        <p class="text-xs sm:text-sm text-pink-100 mt-1 max-w-xl">
                            與嚮導 Moko 🐱 探索日文魅惑單字！每個詞彙皆提供完整的平假名讀音與中文翻譯。
                        </p>
                    </div>
                    <div class="flex items-center gap-3 bg-white/20 backdrop-blur-md px-5 py-3 rounded-2xl border border-white/30">
                        <div class="text-center">
                            <p class="text-xs text-pink-100">當前關卡</p>
                            <p id="mapCurrentStageText" class="text-xl font-black">第 1 關</p>
                        </div>
                        <div class="w-px h-8 bg-white/30"></div>
                        <div class="text-center">
                            <p class="text-xs text-pink-100">探險完成度</p>
                            <p id="mapCompletionPercent" class="text-xl font-black">0%</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- World Switch Tabs -->
            <div class="flex justify-center gap-3 my-4">
                <button onclick="switchWorld(1)" id="worldTab1" class="px-5 py-2.5 rounded-2xl font-black text-sm transition-all shadow-md bg-white text-pink-600 border-2 border-pink-300 flex items-center gap-2">
                    ✨ 第一世界：光芒與極致魅力 (1-4 關)
                </button>
                <button onclick="switchWorld(2)" id="worldTab2" class="px-5 py-2.5 rounded-2xl font-black text-sm transition-all bg-gray-100 text-gray-500 border-2 border-transparent hover:bg-purple-50 flex items-center gap-2">
                    🥀 第二世界：危險與暗黑魅惑 (5-8 關)
                </button>
            </div>

            <!-- Map Stages Container -->
            <div class="bg-white/80 backdrop-blur-md rounded-3xl p-6 shadow-md border border-pink-100 relative min-h-[480px] flex flex-col justify-center items-center overflow-hidden">
                <div id="mapAvatar" class="absolute z-20 transition-all duration-700 ease-out flex flex-col items-center pointer-events-none" style="top: 0; left: 0; transform: translate(-50%, -100%);">
                    <div class="bg-white/90 text-pink-600 font-extrabold text-[10px] px-2.5 py-0.5 rounded-full shadow-md border border-pink-200 mb-1 animate-pulse">
                        📍 目前位置
                    </div>
                    <div class="w-12 h-12 bg-pink-400 text-white rounded-full flex items-center justify-center text-2xl shadow-lg border-2 border-white animate-float">
                        🐱
                    </div>
                </div>

                <div id="stagesContainer" class="w-full max-w-2xl relative z-10 grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8 py-4">
                    <!-- Dynamic Stage Cards -->
                </div>
            </div>
        </section>

        <!-- ==================== TAB 2: 單字庫 (FLASHCARDS & LIBRARY) ==================== -->
        <section id="tab-cards" class="hidden space-y-6">
            <div class="bg-white rounded-3xl p-4 sm:p-6 shadow-md border border-pink-100 no-print">
                <div class="flex flex-col md:flex-row gap-4 justify-between items-center">
                    
                    <div class="relative w-full md:w-1/3">
                        <i class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-gray-400"></i>
                        <input type="text" id="searchInput" oninput="filterWords()" placeholder="搜尋漢字、平假名或中文翻譯..."
                            class="w-full pl-11 pr-4 py-2.5 rounded-2xl border border-pink-200 focus:outline-none focus:ring-2 focus:ring-pink-300 text-sm">
                    </div>

                    <div class="flex flex-wrap gap-2 w-full md:w-auto justify-center">
                        <button onclick="setCategory('all')" id="cat-all" class="cat-btn px-4 py-2 rounded-2xl text-xs font-bold bg-pink-500 text-white shadow-sm btn-bounce">全部 (200)</button>
                        <button onclick="setCategory('positive')" id="cat-positive" class="cat-btn px-4 py-2 rounded-2xl text-xs font-bold bg-gray-100 text-gray-600 hover:bg-pink-100 btn-bounce">✨ 正面魅力</button>
                        <button onclick="setCategory('negative')" id="cat-negative" class="cat-btn px-4 py-2 rounded-2xl text-xs font-bold bg-gray-100 text-gray-600 hover:bg-purple-100 btn-bounce">🥀 負面魅力</button>
                        <button onclick="setCategory('fav')" id="cat-fav" class="cat-btn px-4 py-2 rounded-2xl text-xs font-bold bg-gray-100 text-gray-600 hover:bg-yellow-100 btn-bounce">❤️ 收藏 (<span id="favCount">0</span>)</button>
                    </div>

                    <div class="flex gap-2 w-full md:w-auto justify-end">
                        <button onclick="openAddModal()" class="px-4 py-2 bg-pastel-green/70 hover:bg-pastel-green text-green-900 rounded-2xl text-xs font-bold btn-bounce shadow-sm">
                            <i class="fa-solid fa-plus mr-1"></i> 新增詞彙
                        </button>
                        <button onclick="window.print()" class="px-4 py-2 bg-pastel-blue/70 hover:bg-pastel-blue text-blue-900 rounded-2xl text-xs font-bold btn-bounce shadow-sm">
                            <i class="fa-solid fa-print mr-1"></i> 列印/PDF
                        </button>
                    </div>
                </div>
            </div>

            <!-- Card Grid -->
            <div id="wordGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 card-grid-print">
                <!-- JS Generated Cards -->
            </div>

            <div id="emptyState" class="hidden text-center py-16 text-gray-400">
                <i class="fa-regular fa-face-frown text-5xl mb-3"></i>
                <p class="text-lg font-bold">沒有找到符合搜尋條件的詞彙哦～</p>
            </div>
        </section>

        <!-- ==================== TAB 3: 四選一測驗 (QUIZ) ==================== -->
        <section id="tab-quiz" class="hidden space-y-6 max-w-2xl mx-auto">
            <div class="bg-white rounded-3xl p-6 sm:p-8 shadow-md border border-pink-100 text-center relative overflow-hidden">
                
                <div class="w-full bg-pink-100 rounded-full h-3 mb-6 overflow-hidden">
                    <div id="quizProgressBar" class="bg-gradient-to-r from-pink-400 to-purple-500 h-full rounded-full transition-all duration-300" style="width: 10%;"></div>
                </div>

                <div class="flex justify-between items-center mb-4 text-xs font-bold text-gray-500">
                    <span id="quizProgressText">第 1 / 5 題</span>
                    <span id="quizStageTitle" class="bg-pink-100 text-pink-600 px-3 py-1 rounded-full font-bold">自由練習模式</span>
                    <div class="flex gap-3">
                        <span class="text-green-500"><i class="fa-solid fa-circle-check"></i> <span id="quizScore">0</span></span>
                        <span class="text-red-400"><i class="fa-solid fa-circle-xmark"></i> <span id="quizWrong">0</span></span>
                    </div>
                </div>

                <!-- Question Box -->
                <div class="my-6 py-6 bg-pink-50/50 rounded-2xl border border-pink-100 px-4">
                    <span id="quizEmoji" class="text-4xl block mb-2">✨</span>
                    <!-- Kanji Kanji Word -->
                    <div class="text-3xl sm:text-4xl font-black text-gray-800 my-1 flex items-center justify-center gap-3">
                        <span id="quizQuestion">美貌</span>
                        <button onclick="playTTS(document.getElementById('quizQuestion').innerText)" class="text-pink-400 hover:text-pink-600 text-2xl btn-bounce">
                            <i class="fa-solid fa-volume-high"></i>
                        </button>
                    </div>
                    <!-- Furigana Reader -->
                    <div class="inline-block bg-white/80 px-4 py-1 rounded-full border border-pink-200 mt-2">
                        <p class="text-pink-600 font-extrabold text-sm sm:text-base">讀音 (平假名): <span id="quizFurigana">びぼう</span></p>
                    </div>
                </div>

                <!-- Options Grid -->
                <div id="quizOptions" class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 mt-6">
                    <!-- Dynamic Options with Japanese & Chinese -->
                </div>

                <div id="quizFeedback" class="mt-6 hidden">
                    <div id="quizResultMsg" class="font-bold text-base mb-4"></div>
                    <button id="quizNextBtn" onclick="nextQuizQuestion()" class="w-full py-3.5 bg-pink-500 hover:bg-pink-600 text-white rounded-2xl font-black transition shadow-md btn-bounce">
                        下一題 <i class="fa-solid fa-arrow-right ml-1"></i>
                    </button>
                </div>
            </div>
        </section>

        <!-- ==================== TAB 4: 記憶對對碰 (MEMORY MATCH) ==================== -->
        <section id="tab-match" class="hidden space-y-6 max-w-4xl mx-auto">
            <div class="bg-white rounded-3xl p-6 shadow-md border border-pink-100">
                <div class="flex flex-wrap justify-between items-center mb-6 gap-4">
                    <div>
                        <h2 class="text-xl font-bold text-gray-800">🧩 雙語記憶配對挑戰</h2>
                        <p class="text-xs text-gray-500">配對日文卡（含漢字與平假名）與中文解釋卡！</p>
                    </div>
                    <div class="flex items-center gap-4">
                        <div class="bg-pink-50 px-4 py-2 rounded-2xl text-xs font-bold text-pink-600 border border-pink-100">
                            ⏱️ 計時: <span id="matchTimer" class="text-sm font-black">0</span> 秒
                        </div>
                        <button onclick="initMatchGame()" class="px-4 py-2 bg-pink-500 hover:bg-pink-600 text-white rounded-2xl text-xs font-bold transition shadow-sm btn-bounce">
                            <i class="fa-solid fa-rotate-right mr-1"></i> 重置遊戲
                        </button>
                    </div>
                </div>

                <div id="matchGrid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3 sm:gap-4">
                    <!-- Dynamic Match Cards -->
                </div>
            </div>
        </section>

        <!-- ==================== TAB 5: 角色魅力稱號生成器 (GENERATOR) ==================== -->
        <section id="tab-generator" class="hidden space-y-6 max-w-3xl mx-auto">
            <div class="bg-gradient-to-br from-pink-100 via-purple-100 to-indigo-100 rounded-3xl p-6 sm:p-10 shadow-lg border border-pink-200 text-center relative overflow-hidden">
                
                <div class="w-20 h-20 bg-white rounded-full shadow-md mx-auto flex items-center justify-center text-4xl mb-4 animate-float">
                    🎭
                </div>
                <h2 class="text-2xl sm:text-3xl font-black text-gray-800 mb-2">角色魅力稱號與風格標籤生成器</h2>
                <p class="text-xs sm:text-sm text-gray-600 mb-8 max-w-md mx-auto">為創作者提供組合稱號！一鍵生成包含日文漢字、平假名與中文釋義的魅惑角色屬性。</p>

                <div class="flex justify-center gap-3 mb-8">
                    <label class="inline-flex items-center gap-2 bg-white px-4 py-2 rounded-2xl shadow-sm text-xs font-bold cursor-pointer btn-bounce">
                        <input type="radio" name="genType" value="mixed" checked class="text-pink-500 focus:ring-pink-400"> 🎲 混沌混和
                    </label>
                    <label class="inline-flex items-center gap-2 bg-white px-4 py-2 rounded-2xl shadow-sm text-xs font-bold cursor-pointer btn-bounce">
                        <input type="radio" name="genType" value="positive" class="text-pink-500 focus:ring-pink-400"> ✨ 純粹光彩
                    </label>
                    <label class="inline-flex items-center gap-2 bg-white px-4 py-2 rounded-2xl shadow-sm text-xs font-bold cursor-pointer btn-bounce">
                        <input type="radio" name="genType" value="negative" class="text-pink-500 focus:ring-pink-400"> 🥀 致命毒性
                    </label>
                </div>

                <button onclick="generateCharacter()" class="px-8 py-4 bg-gradient-to-r from-pink-500 via-purple-500 to-indigo-500 hover:from-pink-600 hover:to-indigo-600 text-white rounded-3xl font-black text-base sm:text-lg shadow-lg transition transform active:scale-95 mb-8 btn-bounce">
                    ✨ 一鍵抽卡！生成角色屬性
                </button>

                <div id="genResultCard" class="bg-white/90 backdrop-blur-md rounded-3xl p-6 shadow-md border border-pink-100 space-y-6">
                    <p class="text-[10px] font-black text-gray-400 uppercase tracking-widest">Character Profile & Charm Title</p>
                    
                    <div id="genTitleOutput" class="text-xl sm:text-2xl font-black text-pink-600 bg-pink-50 py-3 px-4 rounded-2xl border border-pink-200">
                        點擊上方按鈕開始生成...
                    </div>

                    <div id="genTags" class="flex flex-wrap justify-center gap-3">
                        <!-- Dynamic Tags with Furigana & Chinese -->
                    </div>

                    <div id="genSummary" class="text-xs sm:text-sm text-gray-600 bg-pink-50/50 p-4 rounded-2xl border border-pink-100 hidden text-left leading-relaxed">
                        <!-- Summary Description -->
                    </div>

                    <div class="flex justify-center gap-3 pt-2">
                        <button onclick="copyCharResult()" class="px-5 py-2.5 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-2xl text-xs font-bold transition btn-bounce">
                            <i class="fa-regular fa-copy mr-1"></i> 複製角色屬性資料
                        </button>
                    </div>
                </div>
            </div>
        </section>

    </main>

    <!-- Floating Mascot Guide (Moko) -->
    <div id="mascotContainer" class="fixed bottom-4 right-4 z-40 flex items-end gap-3 no-print">
        <div id="mascotBubble" class="bg-white/95 backdrop-blur-md text-gray-800 p-3.5 rounded-2xl rounded-br-none shadow-xl border border-pink-200 text-xs sm:text-sm font-bold max-w-xs transition-all duration-300 animate-float">
            <span id="mascotText">こんにちは！我是嚮導 Moko 🐱！所有單字都有標註平假名與中文意思哦！</span>
        </div>
        <button onclick="interactMascot()" class="w-14 h-14 bg-gradient-to-tr from-pink-400 to-purple-400 rounded-full flex items-center justify-center text-3xl shadow-xl border-2 border-white btn-bounce relative group flex-shrink-0">
            🐱
            <span class="absolute -top-1 -right-1 flex h-3 w-3">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-pink-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-3 w-3 bg-pink-500"></span>
            </span>
        </button>
    </div>

    <!-- Custom Word Modal -->
    <div id="addModal" class="fixed inset-0 bg-black/40 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
        <div class="bg-white rounded-3xl max-w-md w-full p-6 shadow-2xl space-y-4">
            <div class="flex justify-between items-center border-b pb-3">
                <h3 class="font-bold text-lg text-gray-800">➕ 新增自訂魅力詞彙</h3>
                <button onclick="closeAddModal()" class="text-gray-400 hover:text-gray-600 text-lg"><i class="fa-solid fa-xmark"></i></button>
            </div>
            
            <form id="addWordForm" onsubmit="saveCustomWord(event)" class="space-y-3">
                <div>
                    <label class="block text-xs font-bold text-gray-600 mb-1">日文 (漢字 / 單字)</label>
                    <input type="text" id="newWord" required placeholder="例如：美貌" class="w-full px-3 py-2 border rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-pink-300">
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-600 mb-1">平假名 (讀音)</label>
                    <input type="text" id="newFurigana" required placeholder="例如：びぼう" class="w-full px-3 py-2 border rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-pink-300">
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-600 mb-1">中文釋義</label>
                    <input type="text" id="newMeaning" required placeholder="例如：美貌、容顏姣好" class="w-full px-3 py-2 border rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-pink-300">
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-bold text-gray-600 mb-1">屬性分類</label>
