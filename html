                                🗺️ 返回地圖
                            </button>
                            <button onclick="${quizCurrentStageId ? `startStageChallenge(${quizCurrentStageId})` : 'startFreeQuiz()'}" class="px-5 py-2.5 bg-pink-500 hover:bg-pink-600 text-white font-bold rounded-2xl text-xs btn-bounce">
                                🔄 重新測驗
                            </button>
                        </div>
                    </div>
                `;
                document.getElementById('quizFeedback').classList.add('hidden');
                return;
            }

            const current = quizQuestions[quizIndex];
            const progressPct = Math.round(((quizIndex + 1) / quizQuestions.length) * 100);
            document.getElementById('quizProgressBar').style.width = `${progressPct}%`;

            document.getElementById('quizProgressText').innerText = `第 ${quizIndex + 1} / ${quizQuestions.length} 題`;
            document.getElementById('quizQuestion').innerText = current.word;
            document.getElementById('quizFurigana').innerText = current.furigana;
            document.getElementById('quizEmoji').innerText = current.emoji;

            let options = [current];
            while (options.length < 4) {
                let random = database[Math.floor(Math.random() * database.length)];
                if (!options.find(o => o.id === random.id)) {
                    options.push(random);
                }
            }
            options.sort(() => 0.5 - Math.random());

            const optContainer = document.getElementById('quizOptions');
            optContainer.innerHTML = '';
            document.getElementById('quizFeedback').classList.add('hidden');

            options.forEach(opt => {
                const btn = document.createElement('button');
                btn.className = "quiz-opt-btn p-4 rounded-2xl border-2 border-pink-100 font-bold text-sm text-gray-700 hover:border-pink-300 hover:bg-pink-50/50 transition text-left flex flex-col justify-between btn-bounce";
                btn.innerHTML = `
                    <span class="text-gray-800 text-base">${opt.meaning}</span>
                    <span class="text-xs text-pink-500 mt-1">(${opt.word} - ${opt.furigana})</span>
                `;
                btn.onclick = () => checkQuizAnswer(opt, current, btn);
                optContainer.appendChild(btn);
            });

            playTTS(current.word);
        }

        function checkQuizAnswer(selected, correct, btnEl) {
            const allBtns = document.querySelectorAll('.quiz-opt-btn');
            allBtns.forEach(b => b.disabled = true);

            const feedback = document.getElementById('quizFeedback');
            const resultMsg = document.getElementById('quizResultMsg');

            if (selected.id === correct.id) {
                playSound('correct');
                quizScore++;
                document.getElementById('quizScore').innerText = quizScore;
                btnEl.className = "quiz-opt-btn p-4 rounded-2xl border-2 border-green-500 bg-green-50 font-bold text-sm text-green-700 text-left flex flex-col justify-between";
                resultMsg.className = "font-bold text-base text-green-600 mb-3";
                resultMsg.innerText = `✨ 正確！【${correct.word} (${correct.furigana})】意思就是「${correct.meaning}」！`;
                interactMascot("答對了！讀音和中文意思都記得很熟練哦！👍");
            } else {
                playSound('wrong');
                quizWrong++;
                document.getElementById('quizWrong').innerText = quizWrong;
                btnEl.className = "quiz-opt-btn p-4 rounded-2xl border-2 border-red-400 bg-red-50 font-bold text-sm text-red-600 text-left flex flex-col justify-between";
                resultMsg.className = "font-bold text-base text-red-500 mb-3";
                resultMsg.innerText = `❌ 答錯囉！正確答案是：「${correct.meaning}」 【日文：${correct.word} (${correct.furigana})】`;
                interactMascot("沒關係！再看一次平假名與中文，下次一定會！💪");
            }

            feedback.classList.remove('hidden');
        }

        function nextQuizQuestion() {
            playSound('click');
            quizIndex++;
            showQuizQuestion();
        }

        function startFreeQuiz() {
            quizCurrentStageId = null;
            document.getElementById('quizStageTitle').innerText = "自由練習模式";
            quizQuestions = [...database].sort(() => 0.5 - Math.random()).slice(0, 10);
            quizIndex = 0;
            quizScore = 0;
            quizWrong = 0;
            document.getElementById('quizScore').innerText = 0;
            document.getElementById('quizWrong').innerText = 0;
            showQuizQuestion();
        }

        function renderWordGrid() {
            const grid = document.getElementById('wordGrid');
            const empty = document.getElementById('emptyState');
            grid.innerHTML = '';

            let filtered = database.filter(item => {
                const matchCat = currentCategory === 'all' || 
                                 (currentCategory === 'fav' && favorites.includes(item.id)) || 
                                 item.type === currentCategory;
                const matchSearch = item.word.toLowerCase().includes(searchQuery.toLowerCase()) || 
                                    item.furigana.toLowerCase().includes(searchQuery.toLowerCase()) || 
                                    item.meaning.includes(searchQuery);
                return matchCat && matchSearch;
            });

            if (filtered.length === 0) {
                empty.classList.remove('hidden');
            } else {
                empty.classList.add('hidden');
            }

            filtered.forEach(item => {
                const isFav = favorites.includes(item.id);
                const isPositive = item.type === 'positive';
                const bgHeader = isPositive ? 'bg-pink-100/60 text-pink-700' : 'bg-purple-100/60 text-purple-700';
                
                const cardHtml = `
                    <div class="perspective-1000 h-60 cursor-pointer group" onclick="flipCard(this)">
                        <div class="card-inner relative w-full h-full duration-500 transform-style-3d transition-transform bg-white rounded-3xl shadow-sm hover:shadow-md border border-pink-100 overflow-hidden">
                            
                            <!-- Front Card (Kanji + Hiragana) -->
                            <div class="absolute inset-0 backface-hidden p-5 flex flex-col justify-between">
                                <div class="flex justify-between items-center">
                                    <span class="px-3 py-1 rounded-full text-xs font-bold ${bgHeader}">
                                        ${item.emoji} ${isPositive ? '正面魅力' : '負面魅力'}
                                    </span>
                                    <div class="flex items-center gap-2">
                                        <button onclick="event.stopPropagation(); playTTS('${item.word}')" class="text-gray-400 hover:text-pink-500 transition text-lg p-1 btn-bounce">
                                            <i class="fa-solid fa-volume-high"></i>
                                        </button>
                                        <button onclick="event.stopPropagation(); toggleFav(${item.id})" class="text-lg p-1 ${isFav ? 'text-red-500' : 'text-gray-300 hover:text-red-400'} btn-bounce">
                                            <i class="fa-${isFav ? 'solid' : 'regular'} fa-heart"></i>
                                        </button>
                                    </div>
                                </div>

                                <div class="text-center my-auto">
                                    <!-- Hiragana Furigana -->
                                    <p class="text-sm font-extrabold text-pink-500 bg-pink-50 inline-block px-3 py-0.5 rounded-full mb-1">
                                        ${item.furigana}
                                    </p>
                                    <!-- Kanji Word -->
                                    <h3 class="text-2xl sm:text-3xl font-black text-gray-800">${item.word}</h3>
                                </div>

                                <p class="text-[11px] text-center text-gray-400 flex items-center justify-center gap-1">
                                    <i class="fa-solid fa-arrows-rotate"></i> 點擊翻看中文釋義
                                </p>
                            </div>

                            <!-- Back Card (Japanese + Chinese Meaning) -->
                            <div class="absolute inset-0 backface-hidden rotate-y-180 p-5 flex flex-col justify-between bg-gradient-to-br ${isPositive ? 'from-pink-50 to-orange-50' : 'from-purple-50 to-blue-50'}">
                                <div class="flex justify-between items-center">
                                    <span class="text-xs font-extrabold text-pink-600">${item.word} (${item.furigana})</span>
                                    <button onclick="event.stopPropagation(); playTTS('${item.word}')" class="text-pink-500 hover:text-pink-700 transition btn-bounce">
                                        <i class="fa-solid fa-volume-high"></i>
                                    </button>
                                </div>

                                <div class="text-center my-auto px-2">
                                    <p class="text-xs text-gray-400 font-bold mb-1">【中文翻譯】</p>
                                    <p class="text-lg font-black text-gray-800">${item.meaning}</p>
                                </div>

                                <p class="text-[11px] text-center text-gray-400">點擊翻回正面</p>
                            </div>

                        </div>
                    </div>
                `;
                grid.innerHTML += cardHtml;
            });

            document.getElementById('favCount').innerText = favorites.length;
        }

        function flipCard(cardEl) {
            playSound('flip');
            const inner = cardEl.querySelector('.card-inner');
            inner.classList.toggle('rotate-y-180');
        }

        function setCategory(cat) {
            playSound('click');
            currentCategory = cat;
            document.querySelectorAll('.cat-btn').forEach(btn => {
                btn.className = "cat-btn px-4 py-2 rounded-2xl text-xs font-bold bg-gray-100 text-gray-600 hover:bg-pink-100 btn-bounce";
            });
            document.getElementById(`cat-${cat}`).className = "cat-btn px-4 py-2 rounded-2xl text-xs font-bold bg-pink-500 text-white shadow-sm btn-bounce";
            renderWordGrid();
        }

        function filterWords() {
            searchQuery = document.getElementById('searchInput').value;
            renderWordGrid();
        }

        function toggleFav(id) {
            playSound('click');
            if (favorites.includes(id)) {
                favorites = favorites.filter(fId => fId !== id);
            } else {
                favorites.push(id);
            }
            localStorage.setItem('jp_favs', JSON.stringify(favorites));
            renderWordGrid();
        }

        function initMatchGame() {
            clearInterval(matchTimer);
            matchSeconds = 0;
            matchedPairs = 0;
            document.getElementById('matchTimer').innerText = 0;
            
            matchTimer = setInterval(() => {
                matchSeconds++;
                document.getElementById('matchTimer').innerText = matchSeconds;
            }, 1000);

            const selected = [...database].sort(() => 0.5 - Math.random()).slice(0, 6);
            matchCards = [];

            selected.forEach(item => {
                matchCards.push({ pairId: item.id, text: item.word, furigana: item.furigana, type: 'jp', emoji: item.emoji });
                matchCards.push({ pairId: item.id, text: item.meaning, type: 'zh', emoji: item.emoji });
            });

            matchCards.sort(() => 0.5 - Math.random());
            flippedCards = [];

            const grid = document.getElementById('matchGrid');
            grid.innerHTML = '';

            matchCards.forEach((card, index) => {
                const cardEl = document.createElement('div');
                cardEl.className = "match-card h-28 bg-pink-50 hover:bg-pink-100 rounded-2xl border-2 border-pink-200 flex flex-col items-center justify-center cursor-pointer p-2 transition font-bold text-center select-none shadow-sm btn-bounce";
                cardEl.dataset.index = index;
                cardEl.innerHTML = `<span class="text-2xl">❓</span>`;
                cardEl.onclick = () => handleMatchClick(cardEl, card);
                grid.appendChild(cardEl);
            });
        }

        function handleMatchClick(cardEl, card) {
            if (flippedCards.length >= 2 || cardEl.classList.contains('matched') || flippedCards.some(f => f.el === cardEl)) {
                return;
            }

            playSound('flip');
            cardEl.className = "match-card h-28 bg-white rounded-2xl border-2 border-pink-400 flex flex-col items-center justify-center cursor-pointer p-2 transition font-bold text-center select-none shadow-md";
            
            if (card.type === 'jp') {
                cardEl.innerHTML = `
                    <span class="text-xs text-gray-400">${card.emoji} 日文</span>
                    <span class="text-sm font-black text-gray-800 my-0.5">${card.text}</span>
                    <span class="text-[11px] font-extrabold text-pink-500">(${card.furigana})</span>
                `;
                playTTS(card.text);
            } else {
                cardEl.innerHTML = `
                    <span class="text-xs text-gray-400">${card.emoji} 中文釋義</span>
                    <span class="text-sm font-extrabold text-gray-800">${card.text}</span>
                `;
            }

            flippedCards.push({ el: cardEl, card: card });

            if (flippedCards.length === 2) {
                const [first, second] = flippedCards;
                if (first.card.pairId === second.card.pairId && first.card.type !== second.card.type) {
                    playSound('correct');
                    setTimeout(() => {
                        first.el.className = "match-card h-28 bg-green-100 border-2 border-green-300 rounded-2xl flex flex-col items-center justify-center p-2 opacity-60 matched";
                        second.el.className = "match-card h-28 bg-green-100 border-2 border-green-300 rounded-2xl flex flex-col items-center justify-center p-2 opacity-60 matched";
                        flippedCards = [];
                        matchedPairs++;
                        if (matchedPairs === 6) {
                            clearInterval(matchTimer);
                            playSound('clear');
                            confetti({ particleCount: 80, spread: 60, origin: { y: 0.6 } });
                            interactMascot(`🎉 花了 ${matchSeconds} 秒完成配對！日文平假名與中文記得很清楚哦！`);
                        }
                    }, 400);
                } else {
                    playSound('wrong');
                    setTimeout(() => {
                        first.el.className = "match-card h-28 bg-pink-50 hover:bg-pink-100 rounded-2xl border-2 border-pink-200 flex flex-col items-center justify-center cursor-pointer p-2 transition font-bold text-center select-none shadow-sm btn-bounce";
                        second.el.className = "match-card h-28 bg-pink-50 hover:bg-pink-100 rounded-2xl border-2 border-pink-200 flex flex-col items-center justify-center cursor-pointer p-2 transition font-bold text-center select-none shadow-sm btn-bounce";
                        first.el.innerHTML = `<span class="text-2xl">❓</span>`;
                        second.el.innerHTML = `<span class="text-2xl">❓</span>`;
                        flippedCards = [];
                    }, 800);
                }
            }
        }

        function generateCharacter() {
            playSound('clear');
            confetti({ particleCount: 50, spread: 50, origin: { y: 0.5 } });

            const genType = document.querySelector('input[name="genType"]:checked').value;
            let pool = database;
            if (genType === 'positive') pool = database.filter(d => d.type === 'positive');
            if (genType === 'negative') pool = database.filter(d => d.type === 'negative');

            const count = Math.floor(Math.random() * 2) + 3;
            const selected = [...pool].sort(() => 0.5 - Math.random()).slice(0, count);

            const prefixes = ["魅惑之星", "漆黑魔女", "禁忌主宰", "透明傾城", "神秘詩人", "危險姬君"];
            const randomPrefix = prefixes[Math.floor(Math.random() * prefixes.length)];

            document.getElementById('genTitleOutput').innerText = `✨ 『${selected[0].word} (${selected[0].furigana}) の ${randomPrefix}』`;

            const tagsContainer = document.getElementById('genTags');
            tagsContainer.innerHTML = '';

            let tagTexts = [];
            selected.forEach(item => {
                tagTexts.push(`【${item.word} (${item.furigana}) - ${item.meaning}】`);
                const tagEl = document.createElement('div');
                tagEl.className = "px-4 py-2.5 bg-white border border-pink-200 rounded-2xl shadow-sm flex items-center gap-2.5 transition hover:scale-105 cursor-pointer btn-bounce";
                tagEl.onclick = () => playTTS(item.word);
                tagEl.innerHTML = `
                    <span class="text-lg">${item.emoji}</span>
                    <div class="text-left">
                        <p class="font-extrabold text-gray-800 text-xs sm:text-sm">
                            ${item.word} <span class="text-pink-500 font-bold">(${item.furigana})</span>
                        </p>
                        <p class="text-xs text-gray-600 font-bold mt-0.5">釋義：${item.meaning}</p>
                    </div>
                `;
                tagsContainer.appendChild(tagEl);
            });

            const summary = document.getElementById('genSummary');
            summary.classList.remove('hidden');
            summary.innerHTML = `
                ✨ <strong>角色魅力屬性標籤：</strong><br>${tagTexts.join(' × ')}<br><br>
                <span class="text-xs text-gray-600">風格描述：此角色兼具「${selected[0].meaning}」與「${selected[1].meaning}」的氣質吸引力。</span>
            `;

            interactMascot("角色屬性生成完成！點擊下方按鈕即可複製完整日文與中文資料！");
        }

        function copyCharResult() {
            playSound('click');
            const title = document.getElementById('genTitleOutput').innerText;
            const summaryText = document.getElementById('genSummary').innerText;
            const fullText = `${title}\n${summaryText}`;

            const input = document.createElement('textarea');
            input.value = fullText;
            document.body.appendChild(input);
            input.select();
            document.execCommand('copy');
            document.body.removeChild(input);

            interactMascot("✨ 已為你複製角色屬性資料（含漢字、假名與中文）囉！");
        }

        // Modal Logic
        function openAddModal() { playSound('click'); document.getElementById('addModal').classList.remove('hidden'); }
        function closeAddModal() { playSound('click'); document.getElementById('addModal').classList.add('hidden'); }

        function saveCustomWord(e) {
            e.preventDefault();
            playSound('clear');
            const newWord = {
                id: Date.now(),
                stageId: 1,
                word: document.getElementById('newWord').value,
                furigana: document.getElementById('newFurigana').value,
                meaning: document.getElementById('newMeaning').value,
                type: document.getElementById('newType').value,
                emoji: document.getElementById('newEmoji').value || '💫'
            };

            customWords.push(newWord);
            localStorage.setItem('jp_custom_words', JSON.stringify(customWords));
            database.push(newWord);

            closeAddModal();
            document.getElementById('addWordForm').reset();
            renderWordGrid();
            interactMascot("🎉 自訂單字新增成功囉！");
        }

        // Navigation
        function switchTab(tabName) {
            playSound('click');
            ['map', 'cards', 'quiz', 'match', 'generator'].forEach(t => {
                document.getElementById(`tab-${t}`).classList.add('hidden');
                document.getElementById(`nav-${t}`).className = "px-3.5 py-1.5 rounded-xl font-bold text-xs sm:text-sm text-gray-600 hover:text-pink-600 transition-all btn-bounce flex items-center gap-1.5";
            });

            document.getElementById(`tab-${tabName}`).classList.remove('hidden');
            document.getElementById(`nav-${tabName}`).className = "px-3.5 py-1.5 rounded-xl font-bold text-xs sm:text-sm transition-all bg-white text-pink-600 shadow-sm btn-bounce flex items-center gap-1.5";

            if (tabName === 'map') renderQuestMap();
            if (tabName === 'cards') renderWordGrid();
            if (tabName === 'quiz' && quizQuestions.length === 0) startFreeQuiz();
            if (tabName === 'match') initMatchGame();
        }

        // Initialize App
        window.onload = function() {
            renderQuestMap();
            renderWordGrid();
        };
    </script>
</body>
</html>
